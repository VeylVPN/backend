dev veyl-tcp
dev-type tun
topology subnet
server 10.9.0.0 255.255.255.0
server-ipv6 fd88:88:89::/64
proto tcp-server
port 443
port-share 127.0.0.1 8443
ca /var/lib/veyl/ca.crt
cert /var/lib/veyl/server.crt
key /var/lib/veyl/server.key
dh none
tls-crypt-v2 /var/lib/veyl/tls-crypt-v2-server.key force-cookie
tls-crypt-v2-verify "/usr/local/bin/veyl hook verify"
client-connect "/usr/local/bin/veyl hook connect"
script-security 2
crl-verify /var/lib/veyl/crl.pem
remote-cert-tls client
verify-client-cert require
tls-server
tls-cert-profile preferred
tls-version-min 1.2
tls-groups X25519MLKEM768:X25519:secp256r1
data-ciphers AES-256-GCM:CHACHA20-POLY1305:AES-128-GCM
allow-compression no
push "redirect-gateway def1 ipv6 bypass-dhcp"
push "block-outside-dns"
keepalive 10 60
max-clients 250
user veyl-ovpn
group veyl
persist-key
persist-tun
verb 0
mute-replay-warnings
management /run/veyl/mgmt-tcp unix
