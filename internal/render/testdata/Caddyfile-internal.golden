{
	admin off
	https_port 8443
	default_bind 127.0.0.1
	auto_https disable_redirects
	log default {
		output discard
	}
	servers {
		protocols h1 h2
	}
}

http:// {
	bind 0.0.0.0 [::]
	redir https://{host}{uri} 308
}

203.0.113.7 {
	tls internal
	encode zstd gzip
	reverse_proxy 127.0.0.1:8080 {
		header_up X-Forwarded-Proto https
	}
}
